<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#050505">

<title>DAKPRO ÉLITE | Boutique</title>

<style>
:root{
    --gold:#d4af37;
    --gold2:#f0d76a;
    --dark:#050505;
    --panel:#111;
    --panel2:#181818;
    --border:#303030;
    --text:#fff;
    --muted:#aaa;
    --success:#28a745;
    --danger:#dc3545;
    --blue:#287cff;
}

*{box-sizing:border-box}

body{
    margin:0;
    font-family:Arial,"Segoe UI",sans-serif;
    background:var(--dark);
    color:var(--text);
}

button,input,select,textarea{
    font:inherit;
}

button{
    cursor:pointer;
}

a{
    color:inherit;
    text-decoration:none;
}

.header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(5,5,5,.97);
    border-bottom:1px solid var(--border);
    backdrop-filter:blur(12px);
}

.header-inner{
    max-width:1400px;
    margin:auto;
    min-height:68px;
    padding:10px 18px;
    display:flex;
    align-items:center;
    gap:15px;
}

.logo{
    color:var(--gold);
    font-size:22px;
    font-weight:900;
    white-space:nowrap;
}

.search{
    flex:1;
    position:relative;
}

.search input{
    width:100%;
    padding:13px 15px;
    background:#101010;
    color:white;
    border:1px solid var(--border);
    border-radius:12px;
    outline:none;
}

.search input:focus{
    border-color:var(--gold);
}

.header-actions{
    display:flex;
    gap:8px;
}

.icon-btn{
    border:1px solid var(--border);
    background:#101010;
    color:white;
    border-radius:11px;
    padding:10px 13px;
}

.icon-btn:hover{
    border-color:var(--gold);
    color:var(--gold);
}

.hero{
    max-width:1400px;
    margin:auto;
    padding:28px 18px 15px;
}

.hero-box{
    background:
        linear-gradient(135deg,
        rgba(212,175,55,.18),
        rgba(255,255,255,.02));
    border:1px solid rgba(212,175,55,.3);
    border-radius:20px;
    padding:28px;
}

.hero h1{
    margin:0 0 10px;
    color:var(--gold);
    font-size:clamp(27px,5vw,48px);
}

.hero p{
    margin:0;
    color:#ccc;
    line-height:1.7;
    max-width:800px;
}

.hero-actions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top:20px;
}

.btn{
    border:0;
    border-radius:11px;
    padding:12px 16px;
    font-weight:800;
}

.btn-gold{
    background:var(--gold);
    color:#000;
}

.btn-dark{
    background:#222;
    color:white;
    border:1px solid var(--border);
}

.btn-blue{
    background:var(--blue);
    color:white;
}

.btn-green{
    background:var(--success);
    color:white;
}

.btn-red{
    background:var(--danger);
    color:white;
}

.container{
    max-width:1400px;
    margin:auto;
    padding:15px 18px 50px;
}

.toolbar{
    display:flex;
    gap:10px;
    align-items:center;
    flex-wrap:wrap;
    margin-bottom:18px;
}

.toolbar select{
    padding:11px;
    background:#111;
    border:1px solid var(--border);
    color:white;
    border-radius:10px;
}

.section-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin:20px 0 15px;
}

.section-title h2{
    margin:0;
    color:var(--gold);
}

.counter{
    color:var(--muted);
    font-size:13px;
}

.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px;
}

.product{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:17px;
    overflow:hidden;
    transition:.2s;
}

.product:hover{
    transform:translateY(-2px);
    border-color:rgba(212,175,55,.5);
}

.product-image{
    height:230px;
    background:#080808;
    position:relative;
    overflow:hidden;
}

.product-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.no-image{
    width:100%;
    height:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#777;
    font-size:50px;
}

.badge{
    position:absolute;
    top:10px;
    left:10px;
    background:var(--gold);
    color:#000;
    padding:5px 9px;
    border-radius:999px;
    font-size:11px;
    font-weight:900;
}

.product-body{
    padding:14px;
}

.product-category{
    color:var(--gold);
    font-size:11px;
    text-transform:uppercase;
    margin-bottom:6px;
}

.product-name{
    font-size:17px;
    font-weight:800;
    line-height:1.35;
    min-height:45px;
}

.product-description{
    color:#aaa;
    font-size:12px;
    line-height:1.5;
    margin-top:7px;
    min-height:38px;
}

.price{
    margin-top:12px;
    color:var(--gold2);
    font-size:20px;
    font-weight:900;
}

.old-price{
    margin-left:7px;
    color:#777;
    font-size:12px;
    text-decoration:line-through;
}

.seller{
    margin-top:10px;
    padding-top:9px;
    border-top:1px solid #292929;
    color:#aaa;
    font-size:12px;
}

.product-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:7px;
    margin-top:12px;
}

.product-actions button{
    padding:10px 7px;
    border-radius:9px;
    font-size:12px;
}

.loading,
.empty,
.error-box{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:15px;
    padding:25px;
    text-align:center;
    color:#aaa;
}

.error-box{
    color:#ff9ca7;
    border-color:rgba(220,53,69,.4);
}

.modal{
    position:fixed;
    inset:0;
    z-index:3000;
    display:none;
    background:rgba(0,0,0,.75);
    padding:15px;
    overflow:auto;
}

.modal.show{
    display:flex;
    align-items:center;
    justify-content:center;
}

.modal-card{
    width:min(650px,100%);
    max-height:94vh;
    overflow:auto;
    background:#111;
    border:1px solid var(--border);
    border-radius:18px;
    padding:20px;
}

.modal-head{
    display:flex;
    justify-content:space-between;
    gap:10px;
    align-items:center;
    margin-bottom:15px;
}

.modal-head h2{
    margin:0;
    color:var(--gold);
}

.close{
    border:0;
    background:#222;
    color:white;
    border-radius:8px;
    padding:8px 11px;
}

.form-group{
    margin-bottom:13px;
}

.form-group label{
    display:block;
    margin-bottom:6px;
    color:#bbb;
    font-size:13px;
}

.form-group input,
.form-group textarea,
.form-group select{
    width:100%;
    padding:12px;
    border-radius:10px;
    border:1px solid #3a3a3a;
    background:#050505;
    color:white;
    outline:none;
}

.form-group textarea{
    min-height:90px;
    resize:vertical;
}

.cart-item{
    display:grid;
    grid-template-columns:70px 1fr auto;
    gap:10px;
    align-items:center;
    padding:10px 0;
    border-bottom:1px solid #292929;
}

.cart-item img{
    width:70px;
    height:70px;
    object-fit:cover;
    border-radius:9px;
}

.cart-item-name{
    font-weight:800;
}

.cart-item-price{
    color:var(--gold);
    font-size:13px;
    margin-top:4px;
}

.qty{
    display:flex;
    gap:5px;
    align-items:center;
}

.qty button{
    width:30px;
    height:30px;
    border:1px solid var(--border);
    background:#222;
    color:white;
    border-radius:7px;
}

.cart-total{
    margin-top:18px;
    padding-top:15px;
    border-top:1px solid var(--border);
    display:flex;
    justify-content:space-between;
    font-size:20px;
    font-weight:900;
}

.payment-info{
    background:rgba(212,175,55,.08);
    border:1px solid rgba(212,175,55,.3);
    padding:13px;
    border-radius:11px;
    color:#ddd;
    font-size:13px;
    line-height:1.6;
    margin-bottom:15px;
}

.share-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:8px;
}

.footer{
    border-top:1px solid var(--border);
    background:#080808;
    padding:35px 18px;
    text-align:center;
    color:#777;
    line-height:1.7;
}

.toast{
    position:fixed;
    right:15px;
    bottom:15px;
    z-index:5000;
    background:#222;
    border:1px solid var(--border);
    color:white;
    padding:13px 16px;
    border-radius:11px;
    display:none;
}

.toast.show{
    display:block;
}

@media(max-width:1100px){
    .products{
        grid-template-columns:repeat(3,1fr);
    }
}

@media(max-width:800px){
    .header-inner{
        flex-wrap:wrap;
    }

    .logo{
        width:auto;
    }

    .search{
        order:3;
        flex-basis:100%;
    }

    .products{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:550px){
    .hero-box{
        padding:20px;
    }

    .container,
    .hero{
        padding-left:12px;
        padding-right:12px;
    }

    .products{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .product-image{
        height:175px;
    }

    .product-body{
        padding:10px;
    }

    .product-name{
        font-size:14px;
        min-height:38px;
    }

    .price{
        font-size:16px;
    }

    .product-actions{
        grid-template-columns:1fr;
    }

    .header-actions{
        margin-left:auto;
    }
}

@media(max-width:370px){
    .products{
        grid-template-columns:1fr;
    }
}
</style>
</head>

