async function createOrder(){

    if(!currentUser){

        showToast(
            "Connectez-vous avant de passer une commande."
        );

        window.location.href =
            "connexion.html";

        return;

    }


    if(!cart.length){

        showToast(
            "Votre panier est vide."
        );

        return;

    }


    const customerName =
        $("customerName")
            .value.trim();

    const customerPhone =
        $("customerPhone")
            .value.trim();

    const customerCity =
        $("customerCity")
            .value.trim();

    const customerAddress =
        $("customerAddress")
            .value.trim();

    const paymentMethod =
        $("paymentMethod")
            .value;


    if(
        !customerName ||
        !customerPhone ||
        !customerCity ||
        !customerAddress
    ){

        showToast(
            "Veuillez remplir les informations de livraison."
        );

        return;

    }


    const payButton =
        $("payBtn");


    payButton.disabled =
        true;

    payButton.textContent =
        "Création de la commande...";


    try{

        const total =
            getCartTotal();


        /*
         * Une commande peut contenir plusieurs vendeurs.
         * Le vendeur est conservé individuellement
         * sur chaque ligne.
         */

        const orderItems =
            cart.map(
                item => ({

                    productId:
                        item.productId,

                    sellerId:
                        item.sellerId,

                    quantity:
                        Number(
                            item.quantity
                        ),

                    unitPrice:
                        Number(
                            item.price
                        ),

                    total:
                        Number(
                            item.price
                        ) *
                        Number(
                            item.quantity
                        )

                })
            );


        /*
         * Création d'un identifiant de commande
         * Firebase.
         */

        const orderRef =
            push(
                ref(
                    db,
                    "commandes"
                )
            );


        const orderId =
            orderRef.key;


        const orderData = {

            orderId,

            clientId:
                currentUser.uid,

            clientEmail:
                currentUser.email || "",

            customerName,

            customerPhone,

            customerCity,

            customerAddress,


            /*
             * Affilié éventuel.
             */

            affiliateId:
                affiliateId || "",


            /*
             * Lignes de commande.
             */

            items:
                orderItems,


            /*
             * Montant envoyé à la commande.
             */

            subtotal:
                total,

            totalAmount:
                total,


            /*
             * Le moyen choisi ici est celui
             * disponible sur LA PLATEFORME.
             * Le vendeur ne peut pas le modifier.
             */

            paymentMethod:


                paymentMethod,


            /*
             * IMPORTANT :
             * aucun numéro personnel de vendeur
             * n'est utilisé ici.
             */

            paymentReceiver:
                "DAKPRO_ELITE_PLATFORM",


            paymentStatus:
                "pending",


            orderStatus:
                "pending_payment",


            /*
             * Commission :
             * elle sera confirmée par le système
             * de paiement/backend après paiement.
             *
             * On ne crédite PAS le vendeur ici.
             */

            sellerCommissionStatus:
                "pending",

            affiliateCommissionStatus:
                affiliateId
                    ? "pending"
                    : "none",


            paymentReference:
                "",


            createdAt:
                Date.now(),

            updatedAt:
                Date.now()

        };


        await set(
            orderRef,
            orderData
        );


        /*
         * =================================================
         * POINT D'INTÉGRATION FAYA BUZZ
         * =================================================
         *
         * Le navigateur ne doit pas contenir de clé
         * secrète Faya Buzz.
         *
         * Le paiement réel doit être déclenché par votre
         * backend / Cloud Function / endpoint sécurisé.
         *
         * Exemple de logique :
         *
         * POST /api/create-payment
         *
         * {
         *    orderId,
         *    amount,
         *    paymentMethod
         * }
         *
         * Le backend appelle Faya Buzz.
         *
         * Après confirmation du paiement :
         *
         * paymentStatus = "paid"
         *
         * puis le système calcule les commissions.
         *
         * =================================================
         */


        /*
         * Pour éviter de déclarer un paiement réussi
         * alors qu'il n'a pas été confirmé par Faya Buzz,
         * on laisse la commande en "pending_payment".
         */


        showToast(
            `Commande ${orderId} créée. Paiement en attente.`
        );


        closeModal(
            "checkoutModal"
        );


        cart = [];

        saveCart();

        updateCartCount();

        renderCart();


        /*
         * Redirection vers la page de paiement.
         *
         * Cette page pourra être reliée à votre endpoint
         * sécurisé Faya Buzz.
         */

        window.location.href =
            `paiement.html?orderId=${encodeURIComponent(
                orderId
            )}`;

    }catch(error){

        console.error(
            "Erreur création commande:",
            error
        );

        showToast(
            "Impossible de créer la commande : " +
            error.message
        );

    }finally{

        payButton.disabled =
            false;

        payButton.textContent =
            "🔐 Continuer vers le paiement sécurisé";

    }

}


