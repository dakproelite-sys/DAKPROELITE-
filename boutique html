<script type="module">

/* =========================================================
   FIREBASE
========================================================= */

import {
    auth,
    db
} from "./firebase-config.js";

import {
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/9.23.0/firebase-auth.js";

import {
    ref,
    get,
    push,
    set
} from "https://www.gstatic.com/firebasejs/9.23.0/firebase-database.js";


/* =========================================================
   VARIABLES
========================================================= */

let currentUser = null;

let products = [];

let cart = [];

let selectedProduct = null;

let selectedShareProduct = null;

let affiliateId = null;


/* =========================================================
   OUTILS
========================================================= */

function $(id){
    return document.getElementById(id);
}


function money(value){

    const number = Number(value) || 0;

    return number.toLocaleString(
        "fr-FR"
    ) + " FCFA";
}


function clean(value){

    if(
        value === null ||
        value === undefined
    ){
        return "";
    }

    return String(value).trim();
}


function showToast(message){

    const toast = $("toast");

    toast.textContent = message;

    toast.classList.add("show");

    setTimeout(
        () => toast.classList.remove("show"),
        3000
    );
}


function openModal(id){

    $(id).classList.add("show");
}


function closeModal(id){

    $(id).classList.remove("show");
}


document.querySelectorAll(
    "[data-close]"
).forEach(
    button => {

        button.addEventListener(
            "click",
            () => {

                closeModal(
                    button.dataset.close
                );

            }
        );

    }
);


/* =========================================================
   AUTHENTIFICATION
========================================================= */

onAuthStateChanged(
    auth,
    user => {

        currentUser = user;

        if(user){

            $("accountBtn").textContent =
                "👤 Mon compte";

        }else{

            $("accountBtn").textContent =
                "👤 Connexion";

        }

    }
);


/* =========================================================
   AFFILIATION
========================================================= */

const urlParams =
    new URLSearchParams(
        window.location.search
    );

affiliateId =
    urlParams.get("affiliate") ||
    urlParams.get("aff") ||
    null;


/* =========================================================
   CHARGEMENT DES PRODUITS
========================================================= */

async function loadProducts(){

    $("productsContainer").innerHTML = `
        <div class="loading">
            🔥 Chargement des produits depuis Firebase...
        </div>
    `;

    products = [];

    const uniqueIds =
        new Set();


    try{

        /*
         * SOURCE PRINCIPALE :
         *
         * produits/
         */

        const mainSnapshot =
            await get(
                ref(
                    db,
                    "produits"
                )
            );


        if(mainSnapshot.exists()){

            const data =
                mainSnapshot.val() || {};

            Object.entries(data)
                .forEach(
                    ([productId, product]) => {

                        if(
                            !product ||
                            typeof product !== "object"
                        ){
                            return;
                        }

                        addProduct(
                            productId,
                            product,
                            uniqueIds
                        );

                    }
                );

        }


        /*
         * COMPATIBILITÉ :
         *
         * vendeurs_data/UID/produits/
         *
         * Cette lecture permet également
         * de retrouver les produits qui auraient
         * été enregistrés dans le profil vendeur.
         */

        const sellersSnapshot =
            await get(
                ref(
                    db,
                    "vendeurs_data"
                )
            );


        if(sellersSnapshot.exists()){

            const sellers =
                sellersSnapshot.val() || {};

            Object.entries(sellers)
                .forEach(
                    ([sellerId, sellerData]) => {

                        if(
                            !sellerData ||
                            typeof sellerData !== "object"
                        ){
                            return;
                        }

                        const sellerProducts =
                            sellerData.produits;

                        if(
                            !sellerProducts ||
                            typeof sellerProducts !== "object"
                        ){
                            return;
                        }

                        Object.entries(
                            sellerProducts
                        ).forEach(
                            ([productId, product]) => {

                                if(
                                    !product ||
                                    typeof product !== "object"
                                ){
                                    return;
                                }

                                const merged = {
                                    ...product,
                                    sellerId:
                                        product.sellerId ||
                                        sellerId
                                };

                                addProduct(
                                    productId,
                                    merged,
                                    uniqueIds
                                );

                            }
                        );

                    }
                );

        }


        /*
         * FILTRAGE DES PRODUITS
         */

        products =
            products.filter(
                product => {

                    const status =
                        clean(
                            product.statut ||
                            product.status
                        ).toLowerCase();

                    /*
                     * Si aucun statut n'est fourni,
                     * le produit reste visible.
                     */

                    if(!status){
                        return true;
                    }

                    return [
                        "active",
                        "actif",
                        "published",
                        "publie",
                        "publié",
                        "available",
                        "disponible"
                    ].includes(
                        status
                    );

                }
            );


        buildCategories();

        renderProducts();

    }catch(error){

        console.error(
            "Erreur Firebase produits:",
            error
        );

        $("productsContainer").innerHTML = `
            <div class="error-box">
                Impossible de charger les produits.
                <br><br>
                ${clean(error.message)}
            </div>
        `;

    }

}


/* =========================================================
   AJOUT PRODUIT
========================================================= */

function addProduct(
    productId,
    product,
    uniqueIds
){

    if(
        !productId ||
        uniqueIds.has(productId)
    ){
        return;
    }

    uniqueIds.add(productId);


    const normalized = {

        ...product,

        productId:

            product.productId ||
            product.id ||
            productId,

        sellerId:

            product.sellerId ||
            product.vendeurId ||
            product.userId ||
            product.uid ||
            "",

        name:

            product.name ||
            product.nom ||
            product.titre ||
            product.title ||
            "Produit",

        description:

            product.description ||
            product.desc ||
            "",

        category:

            product.category ||
            product.categorie ||
            "Autres",

        price:

            Number(
                product.price ??
                product.prix ??
                0
            ),

        oldPrice:

            Number(
                product.oldPrice ??
                product.ancienPrix ??
                0
            ),

        stock:

            product.stock ??
            product.quantite ??
            product.quantity ??
            "",

        image:

            product.image ||
            product.photo ||
            product.imageUrl ||
            product.photoUrl ||
            "",

        images:

            product.images ||
            [],

        createdAt:

            product.createdAt ||
            product.dateCreation ||
            0

    };


    products.push(
        normalized
    );

}


